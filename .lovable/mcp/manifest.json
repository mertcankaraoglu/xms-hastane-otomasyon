{
  "version": 1,
  "sdk_version": "3.5.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "xms-hastane-otomasyon",
      "version": "1.0.0",
      "title": "Xms Hastane Otomasyon"
    },
    "tools": [
      {
        "name": "list_departments",
        "title": "Bölümleri listele",
        "description": "Medicare Hastanesi'nin tüm tıbbi bölümlerini (slug, ad, kısa açıklama) listeler.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_department",
        "title": "Bölüm detayı",
        "description": "Bir bölümün açıklaması, hizmetleri, sıkça sorulan soruları ve doktorlarını getirir.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Bölüm slug, örn. kardiyoloji (list_departments'tan)"
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_doctors",
        "title": "Doktor ara",
        "description": "Doktorları bölüm slug'ı ve/veya ad, uzmanlık, bölüm adında geçen metinle arar. Parametresiz çağrı tüm doktorları döner.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "department": {
              "type": "string",
              "maxLength": 120,
              "description": "Bölüm slug filtresi"
            },
            "query": {
              "type": "string",
              "maxLength": 80,
              "description": "Ad, uzmanlık veya bölüm adı metni"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_doctor_profile",
        "title": "Doktor profili",
        "description": "Doktorun yayınlanmış tam profilini getirir: özgeçmiş, eğitim, kariyer, ilgi alanları, diller, sertifikalar, çalışma saatleri (İstanbul).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Doktor slug (search_doctors'tan)"
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_hospital_info",
        "title": "Hastane bilgileri",
        "description": "Adres, iletişim, çalışma saatleri, ulaşım, otopark, sigorta, ziyaret kuralları gibi genel bilgileri ve önümüzdeki kapalı günleri getirir.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_knowledge",
        "title": "Bilgi bankasında ara",
        "description": "Hastane bilgi bankasında anlamsal (RAG) arama yapar ve en ilgili 5 maddeyi benzerlik skoruyla döner. Hastane hakkındaki serbest sorular için kullanın.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "maxLength": 300,
              "description": "Doğal dilde soru, örn. 'Otopark ücretli mi?'"
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_available_slots",
        "title": "Boş saatleri getir",
        "description": "Bir doktorun belirli bir gündeki boş randevu saatlerini döner (Europe/Istanbul). Randevu için 'iso' değerini book_appointment'a starts_at olarak verin.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "doctor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Doktor slug"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "YYYY-MM-DD, İstanbul tarihi"
            }
          },
          "required": [
            "doctor",
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "book_appointment",
        "title": "Randevu oluştur",
        "description": "Randevu oluşturur ve randevu kodunu döner. SADECE kullanıcı doktor, saat ve kişisel bilgilerin özetini gördükten sonra açıkça onay verdiyse çağırın.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "doctor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Doktor slug"
            },
            "starts_at": {
              "type": "string",
              "description": "get_available_slots'tan gelen iso değeri"
            },
            "full_name": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120,
              "description": "Hastanın adı soyadı"
            },
            "tc_no": {
              "type": "string",
              "pattern": "^\\d{11}$",
              "description": "11 haneli TC kimlik no"
            },
            "phone": {
              "type": "string",
              "pattern": "^0[1-9][0-9]{9}$",
              "description": "0 ile başlayan 11 haneli telefon, örn. 05321234567"
            },
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 200,
              "description": "İsteğe bağlı e-posta"
            },
            "complaint": {
              "type": "string",
              "maxLength": 1000,
              "description": "İsteğe bağlı şikayet"
            }
          },
          "required": [
            "doctor",
            "starts_at",
            "full_name",
            "tc_no",
            "phone"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "manage_appointment",
        "title": "Randevu sorgula / iptal et",
        "description": "Randevu kodu ve telefonla randevuyu sorgular (action=lookup) veya iptal eder (action=cancel). İptal geri alınamaz; önce kullanıcıdan açık onay alın.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "lookup",
                "cancel"
              ],
              "description": "lookup = sorgula, cancel = iptal et"
            },
            "code": {
              "type": "string",
              "minLength": 4,
              "maxLength": 20,
              "description": "Randevu kodu"
            },
            "phone": {
              "type": "string",
              "pattern": "^0[1-9][0-9]{9}$",
              "description": "Randevudaki telefon"
            }
          },
          "required": [
            "action",
            "code",
            "phone"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
